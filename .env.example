# Copy to .env and fill all empty secrets with unique randomly generated values. Never commit .env.
APP_DB_ADMIN_PASSWORD=
DB_PASSWORD=
DB_MIGRATION_PASSWORD=
KEYCLOAK_DB_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_STATE_ENCRYPTION_KEY=
SPRING_PROFILES_ACTIVE=local
APP_PORT=8080
DB_USERNAME=app_runtime
DB_MIGRATION_USERNAME=app_migrator
# Host-based development; Compose explicitly replaces these internal endpoints.
DB_URL=jdbc:postgresql://localhost:5432/user_service_db
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/user-service
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/user-service/protocol/openid-connect/certs
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=user-service
KEYCLOAK_CLIENT_ID=user-service-admin
JWT_AUDIENCE=user-service-api
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Configure SMTP to send verification/reset emails. Local development can use an external mail sink.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Optional real identity UUID for an explicitly selected development seed context.
KEYCLOAK_DEV_SEED_USER_ID=

# Optional native local launcher; no Docker needed.
KEYCLOAK_HOME=~/.local/share/mpl-be/keycloak-26.5.5
KEYCLOAK_CONFIG_CLI_JAR=~/.local/share/mpl-be/keycloak-config-cli-6.5.1-26.5.5.jar

SWAGGER_PUBLIC_URL=http://localhost:8080

# Integration release images; build with compose.build.yaml or pull from your registry.
BACKEND_IMAGE=mpl-be:1.0.0
MIGRATION_IMAGE=mpl-db-migrations:1.0.0
IAM_IMAGE=mpl-iam:1.0.0
APP_DB_PORT=5432
KEYCLOAK_PORT=8081
# Set for an explicitly reviewed IAM apply job only; ordinary startup never applies IAM.
MPL_IAM_APPLY_APPROVED=false
